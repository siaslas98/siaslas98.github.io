---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";
---

<BaseLayout title="Tre Huang">
    <header>
      <h1>Portfolio</h1>  
      <nav class="desktop-nav">
        <ul>
          <li><a href="#about">About</a></li>
          <li><a href="#projects">Projects</a></li>
        </ul>
      </nav>
      <nav class="hamburger-nav">
        <div class="hamburger-menu">
          <div class="hamburger-icon" onclick="toggleMenu()">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="menu-links">
            <li><a href="#about" onclick="toggleMenu()">About</a></li>
            <li><a href="#projects" onclick="toggleMenu()">Projects</a></li>
          </div>
        </div>
      </nav>
    </header>
    <main>
      <section>
        <div class="container" id="about">
          <h2>About Me</h2>
          <div class="innerContainer">
            <img id="profile-pic" src="assets/me.jpg" />
            <div class="about-text">
              <p>
                Hey, I’m Tre, a Computer Science student at the University of
                Florida who enjoys building things, solving problems, and learning
                how complex systems work. I’m interested in backend software
                engineering because I like creating the systems that make
                applications reliable, useful, and easy to improve. One project
                I’ve been developing is WeakSquare, a chess training web app that
                lets players upload their games, review positions, tag mistakes by
                theme and severity, and build a personalized queue of positions to
                practice. The goal is to help players identify recurring weaknesses
                and turn them into focused training.
              </p>
              <p>
                Building WeakSquare has given me the chance to work with Python,
                FastAPI, React, PostgreSQL, and chess algorithms while combining two
                of my favorite interests: software and chess.
              </p>
              <p>
                Outside of coding, I enjoy playing strategic games, running, and
                cooking. I’m always curious about how things work, whether I’m
                analyzing a position on the board or trying to improve a recipe in
                the kitchen.
              </p>
            </div>
          </div>

          <div class="myLinksContainer">
            <div class="icons" id="Github">
              <a
                href="https://github.com/siaslas98"
                target="_blank"
                rel="noopener noreferrer"
                ><i class="fa-brands fa-github fa-3x"></i>
              </a>
            </div>
            <div class="icons" id="Linkedin">
              <a
                href="https://www.linkedin.com/in/tre-huang-20862a218/"
                target="_blank"
                rel="noopener noreferrer"
                ><i class="fa-brands fa-linkedin fa-3x"></i>
              </a>
            </div>
          </div>
        </div>
      </section>

      <section>
        <div class="container" id="projects">
          <h2>Projects</h2>
          <div class="project-cards">
            <div class="card">
              <h3 class="project-header">Aspire Link</h3>
              <p class="project-paragraph">
                Internship support tool for Computer Science students seeking internships. Implements gamified checkins, company watchlists, and a notification system.
              </p>
              <div class="project-tech-stack">
                <ul>
                  <li>Python</li>
                  <li>FastAPI</li>
                  <li>SQLAlchemy</li>
                  <li>Jinja2</li>
                </ul>
                <a
                  class="project-link"
                  href="https://github.com/siaslas98/AspireLink"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                <i class="fa-brands fa-github fa-2x"> </i>
                </a>
                
              </div>
            </div>

            <div class="card">
              <h3 class="project-header">Cooks-Match</h3>
              <p class="project-paragraph">Receipt ingredients to recipes that extracts ingredients from a grocery receipt and generates recipes that can be made with them.</p>
              <div class="project-tech-stack">
                <ul>
                  <li>Javascript</li>
                  <li>CSS</li>
                  <li>HTML</li>
                  <li>Python</li>
                  <li>EasyOCR</li>
                  <li>MongoDB</li>
                </ul>
                <a
                  class="project-link"
                  href="https://github.com/siaslas98/Cooks-Match"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                <i class="fa-brands fa-github fa-2x"> </i>
                </a>
              </div>
            </div>
            
            <div class="card">
              <h3 class="project-header">Chess Move Reaction AI</h3>
              <p class="project-paragraph"> Browser based chess move evaluator that takes a move and reacts with logical explanations.</p>

              <div class="project-tech-stack">
                <ul>
                  <li>Python</li>
                  <li>Node.js</li>
                  <li>Stockfish Binary</li>
                </ul>
                <a
                  class="project-link"
                  href="https://github.com/siaslas98/chess-move-reaction-ai"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                <i class="fa-brands fa-github fa-2x"> </i>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section> 
    </main>
    <Footer />
</BaseLayout>
